<div class="card">
    <img 
      class="card__image" 
      src="https://source.unsplash.com/featured/?product
" 
      alt="<%= product.name %>" 
    />
    
    <h3 class="card__title"><%= product.name %></h3>
    
    <p class="card__description"><%= product.description %></p>
    
    <p class="card__price"><%= product.price %> zł</p>
  
    <a href="/products/<%= product.name %>">Zobacz produkt</a>
  
    <form action="/products/<%= product.name %>?_method=DELETE" method="POST" style="display:inline;">
      <button type="submit">Usuń</button>
    </form>
  </div>
  